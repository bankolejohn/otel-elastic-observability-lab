# Copy this file to .env (same directory) and fill in real values.
# .env is gitignored -- it never gets committed. docker compose loads it
# automatically and substitutes ${VAR} references in docker-compose.yml.

# Elasticsearch endpoint URL for your Elastic Cloud trial, e.g.:
#   https://my-deployment.es.us-east-1.aws.elastic.cloud:443
# Found via Connection Details (Help icon) or the "Add Observability data"
# -> OpenTelemetry screen in Kibana.
ELASTIC_ENDPOINT=

# An Elasticsearch API key in "encoded" format (one base64 string, NOT the
# separate id/key pair). Create one in Kibana: Stack Management -> API Keys
# -> Create API key -> copy the "Encoded" value.
ELASTIC_API_KEY=
